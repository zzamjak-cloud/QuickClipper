rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // AI 데일리 리포트: 누구나 읽기, 쓰기는 수집기의 Admin SDK만 (규칙 우회)
    match /digests/{date} {
      allow read: if true;
      allow write: if false;

      match /items/{itemId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // 그 외 경로는 규칙이 없으므로 기본 거부
  }
}
